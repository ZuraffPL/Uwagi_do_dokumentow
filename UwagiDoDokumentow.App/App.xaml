<Application x:Class="UwagiDoDokumentow.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UwagiDoDokumentow.App"
             xmlns:conv="clr-namespace:UwagiDoDokumentow.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:EmptyStringToCollapsedConverter x:Key="EmptyStringToCollapsedConverter" />
            <conv:InverseBooleanConverter x:Key="InverseBoolConverter" />
            <conv:CountGreaterThanZeroConverter x:Key="CountGreaterThanZeroConverter" />
            <conv:EmptySymbolToAllTextConverter x:Key="EmptySymbolToAllTextConverter" />
            <conv:AttachmentThumbnailConverter x:Key="AttachmentThumbnailConverter" />
            <conv:ImageExtensionToVisibilityConverter x:Key="ImageExtensionToVisibilityConverter" />
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
