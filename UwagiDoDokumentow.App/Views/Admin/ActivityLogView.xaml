<Window x:Class="UwagiDoDokumentow.App.Views.Admin.ActivityLogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log aktywności"
        Width="800" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <Grid Margin="20">
        <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140" />
                <DataGridTextColumn Header="Użytkownik" Binding="{Binding User.DisplayName}" Width="140" />
                <DataGridTextColumn Header="Akcja" Binding="{Binding ActionType}" Width="100" />
                <DataGridTextColumn Header="Encja" Binding="{Binding EntityType}" Width="120" />
                <DataGridTextColumn Header="Id" Binding="{Binding EntityId}" Width="60" />
                <DataGridTextColumn Header="Szczegóły" Binding="{Binding Details}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
