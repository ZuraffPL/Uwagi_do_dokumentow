<Window x:Class="UwagiDoDokumentow.App.Views.Admin.DocumentTypesAdminView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administracja — Symbole dokumentów"
        Width="560" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" ItemsSource="{Binding DocumentTypes}" SelectedItem="{Binding SelectedType}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  GridLinesVisibility="Horizontal" SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="80" />
                <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="*" />
                <DataGridCheckBoxColumn Header="Aktywny" Binding="{Binding IsActive}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <Button Content="Aktywuj/dezaktywuj zaznaczony" Padding="10,4" HorizontalAlignment="Left"
                    Command="{Binding ToggleActiveCommand}" Margin="0,0,0,14" />

            <TextBlock Text="Nowy symbol" FontWeight="Bold" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBox Width="80" Margin="0,0,6,0" Padding="4" Text="{Binding NewSymbol, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Width="250" Margin="0,0,6,0" Padding="4" Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" Tag="Opis (opcjonalnie)" />
                <Button Content="Dodaj" Padding="10,4" Command="{Binding AddCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
