<Window x:Class="UwagiDoDokumentow.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logowanie — Uwagi do dokumentów"
        Width="380" Height="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F6F8">
    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=PasswordBox}" />
    </Window.InputBindings>
    <StackPanel Margin="30" VerticalAlignment="Center">
        <TextBlock Text="Uwagi do dokumentów" FontSize="20" FontWeight="Bold"
                    Foreground="#1F3F5F" HorizontalAlignment="Center" Margin="0,0,0,20" />

        <TextBlock Text="Nazwa użytkownika" Margin="0,0,0,4" />
        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                 Padding="6" Margin="0,0,0,12" />

        <TextBlock Text="Hasło" Margin="0,0,0,4" />
        <PasswordBox x:Name="PasswordBox" Padding="6" Margin="0,0,0,12" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"
                   Margin="0,0,0,10" Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyStringToCollapsedConverter}}" />

        <Button Content="Zaloguj" Command="{Binding LoginCommand}"
                CommandParameter="{Binding ElementName=PasswordBox}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                HorizontalAlignment="Stretch" Padding="0,10" />
    </StackPanel>
</Window>
