<Window x:Class="UwagiDoDokumentow.App.Views.NoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="640" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Data dokumentu" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding DocumentDate}" Margin="0,0,0,12" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Symbol dokumentu" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding DocumentTypes}" DisplayMemberPath="Symbol"
                                  SelectedValuePath="Symbol" SelectedValue="{Binding DocumentSymbol}"
                                  Margin="0,0,0,12" Padding="6" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Numer dokumentu" Margin="0,0,0,4" />
                <TextBox Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12" />

                <TextBlock Text="Kto zlecił" Margin="0,0,0,4" />
                <TextBox Text="{Binding OrderedBy, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12" />

                <TextBlock Text="Tytuł (opcjonalnie)" Margin="0,0,0,4" />
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12" />

                <TextBlock Text="Treść — okoliczności powstania dokumentu" Margin="0,0,0,4" />
                <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="120" VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Tagi (opcjonalnie, po przecinku)" Margin="0,0,0,4" />
                <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12" />

                <CheckBox Content="Zarchiwizowana" IsChecked="{Binding IsArchived}" Margin="0,0,0,16" />

                <TextBlock Text="Załączniki" FontWeight="Bold" Margin="0,0,0,6" />
                <ListBox ItemsSource="{Binding Attachments}" Height="140" Margin="0,0,0,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding OriginalFileName}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Otwórz" Margin="6,2" Padding="8,2"
                                        Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                                <Button Grid.Column="2" Content="Usuń" Margin="0,2" Padding="8,2"
                                        Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="Dodaj załącznik…" HorizontalAlignment="Left" Padding="10,4"
                        Click="AddAttachmentButton_Click" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,10,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyStringToCollapsedConverter}}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Anuluj" Padding="14,6" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button Content="Zapisz" Padding="14,6" Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
        </StackPanel>
    </Grid>
</Window>
