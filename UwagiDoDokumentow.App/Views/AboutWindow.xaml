<Window x:Class="UwagiDoDokumentow.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O programie"
        Width="420" Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6F8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <TextBlock Text="Uwagi do dokumentów"
                       FontSize="22" FontWeight="Bold" Foreground="#1F3F5F"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Centralne repozytorium kontekstu do dokumentów obiegających w firmie"
                       FontSize="12" Foreground="#5A6B78" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,20" />

            <TextBlock Text="{Binding VersionText}" FontSize="13" FontWeight="SemiBold"
                       Foreground="#1F2A33" HorizontalAlignment="Center" Margin="0,0,0,6" />
            <TextBlock Text="{Binding AuthorText}" FontSize="12" Foreground="#1F2A33"
                       HorizontalAlignment="Center" Margin="0,0,0,6" />
            <TextBlock Text="{Binding TechStackText}" FontSize="12" Foreground="#5A6B78"
                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
        </StackPanel>

        <Button Grid.Row="1" Content="OK" Width="100" Padding="10,6"
                HorizontalAlignment="Center" Margin="0,20,0,0"
                IsCancel="True" IsDefault="True" Click="OkButton_Click" />
    </Grid>
</Window>
