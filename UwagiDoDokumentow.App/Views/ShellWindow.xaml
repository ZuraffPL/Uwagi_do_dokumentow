<Window x:Class="UwagiDoDokumentow.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:UwagiDoDokumentow.App.Views"
        Title="{Binding WindowTitle}"
        Width="1100" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#1F3F5F">
            <MenuItem Header="Administracja"
                      Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                <MenuItem Header="Użytkownicy" Command="{Binding OpenUsersAdminCommand}" />
                <MenuItem Header="Symbole dokumentów" Command="{Binding OpenDocumentTypesAdminCommand}" />
                <MenuItem Header="Log aktywności" Command="{Binding OpenActivityLogCommand}" />
                <Separator />
                <MenuItem Header="Eksportuj bazę danych..." Command="{Binding ExportDatabaseCommand}" />
                <MenuItem Header="Importuj bazę danych..." Command="{Binding ImportDatabaseCommand}" />
            </MenuItem>
            <MenuItem Header="Pomoc">
                <MenuItem Header="Instrukcja obsługi" Command="{Binding OpenHelpCommand}" />
            </MenuItem>
            <MenuItem Header="O programie" Command="{Binding OpenAboutCommand}" />
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding CurrentUserDisplayName, StringFormat='Zalogowano jako: {0}'}" Margin="6,0" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Button Content="Wyloguj" Command="{Binding LogoutCommand}" Padding="10,2" Margin="6,2" />
            </StatusBarItem>
        </StatusBar>

        <ContentControl x:Name="ContentHost" />
    </DockPanel>
</Window>
