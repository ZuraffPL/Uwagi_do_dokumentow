<Window x:Class="UwagiDoDokumentow.App.Views.VersionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historia wersji"
        Width="640" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Historia wersji — Uwagi do dokumentów"
                   FontSize="20" FontWeight="Bold" Foreground="#1F3F5F" Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{Binding Header}" FontSize="15" FontWeight="Bold"
                                       Foreground="#1F3F5F" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Changes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="•" Foreground="#1F2A33" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" Foreground="#1F2A33" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Zamknij" Width="100" Padding="10,6"
                HorizontalAlignment="Right" Margin="0,16,0,0"
                IsCancel="True" IsDefault="True" Click="CloseButton_Click" />
    </Grid>
</Window>
